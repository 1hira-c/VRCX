{
    admin off
    auto_https disable_redirects
    skip_install_trust
    servers {
        protocols h1 h2
    }
    log {
        output stdout
        format console
    }
}

https://{$VRCX_HOST:vrcx.local}:8443 {
    tls internal
    encode zstd gzip
    header {
        -Server
        Strict-Transport-Security "max-age=15552000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data: blob: https://*.vrchat.cloud https://*.vrchat.com https://*.cloudfront.net; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
    reverse_proxy vrcx-server:8080
}
